<?xml version="1.0"?>
<ruleset name="cs-page-protector">
    <description>cs-page-protector PHP_CodeSniffer ruleset: PSR-12, as Joomla 4+ core uses, with Joomla's usual exclusions.</description>

    <file>packages</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/.joomla-brain/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="ps"/>

    <rule ref="PSR12">
        <!-- Every Joomla file starts with the _JEXEC guard. -->
        <exclude name="PSR1.Files.SideEffects"/>
        <!-- Language-heavy templates and SQL read better unwrapped. -->
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <rule ref="Generic.PHP.Syntax"/>
    <rule ref="Generic.Files.LineEndings">
        <properties>
            <property name="eolChar" value="\n"/>
        </properties>
    </rule>
</ruleset>
