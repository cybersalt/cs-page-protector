<?xml version="1.0"?>
<ruleset name="cs-page-protector">
    <description>cs-page-protector PHP_CodeSniffer ruleset — Joomla coding standards with project overrides.</description>

    <file>packages</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/.joomla-brain/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="ps"/>

    <rule ref="Joomla">
        <!-- We use declare(strict_types=1) in some files; Joomla standard doesn't require it. -->
        <exclude name="Squiz.Commenting.FileComment.Missing"/>
        <!-- Allow short array syntax which is the project convention. -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax.Found"/>
    </rule>

    <rule ref="Generic.PHP.Syntax"/>
    <rule ref="Generic.Files.LineEndings">
        <properties>
            <property name="eolChar" value="\n"/>
        </properties>
    </rule>
</ruleset>
